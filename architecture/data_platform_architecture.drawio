        <mxCell id="c1073" value="1 scheduled trigger   ·   2 egress forced through allow-list firewall   ·   3 API calls (only internet traffic)   ·   4 file streamed via S3 Gateway Endpoint into raw/   ·   5 trigger ETL   ·   6 read raw" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5A6470;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="220.0" y="1459.0" width="1960" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c1074" value="7 write validated Parquet zones   ·   8 DQ publish gate, then register partitions   ·   9 Tableau query   ·   10 Athena over PrivateLink   ·   11 results read back privately" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5A6470;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="220.0" y="1485.0" width="1960" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c1075" value="Availability: ingestion and processing run in one AZ, since a re-run is their recovery path; the Tableau tier is multi-AZ. Costed alternatives in architecture/README.md." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5A6470;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="220.0" y="1511.0" width="1960" height="22" as="geometry" />
